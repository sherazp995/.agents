#!/usr/bin/env bash
# `relay` on PATH: install.py links ~/.local/bin/relay here. Runs the compiled
# CLI of this checkout; `relay update` rebuilds it, and `relay start`, `relay stop`
# and `relay restart` control the daemon, all working even when the build is
# missing or broken, because none loads the compiled code.
set -euo pipefail

source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir=$(cd -P "$(dirname "$source")" && pwd)
  source=$(readlink "$source")
  [[ $source == /* ]] || source="$dir/$source"
done
root=$(cd -P "$(dirname "$source")/.." && pwd)
# This checkout holds the config; without RELAY_HOME, Relay run from any other folder would use ~/.relay.
export RELAY_HOME="${RELAY_HOME:-$root}"

if [ "${1:-}" = update ]; then
  shift
  exec "$root/bin/relay-update" "$@"
fi
case "${1:-}" in
  start | stop | restart) exec "$root/bin/relay-$1" ;;
esac

cli="$root/dist/src/cli.js"
if [ ! -f "$cli" ]; then
  echo "Relay is not built in $root yet. Run: relay update" >&2
  exit 1
fi
exec node "$cli" "$@"
