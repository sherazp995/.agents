node_modules/
dist/
tmp/
.env
.DS_Store

# The old browser profile registry. Relay no longer reads it, but an
# operator's leftover copy names real clients and points at directories
# holding copies of their cookies, so it stays out of git.
config/profiles.yaml

# The repository registry names the operator's own checkouts, their remotes,
# and which paths inside them are off limits. One operator's configuration,
# not part of Relay. The
# tracked template is config/repos.example.yaml.
config/repos.yaml
/run/
# relay install-service builds the macOS relay-secrets helper here; the PATH
# wrapper and the update script beside it are tracked.
/bin/*
!/bin/relay
!/bin/relay-update

# Runtime data Relay writes under its home: task dirs (inbox downloads, QA checkouts) and team run personas.
/tasks/
/team-runs/
