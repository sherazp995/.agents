#!/usr/bin/env python3
"""Stop hook: when a task is finished, have a fresh checker confirm it is complete and correct, once.

A turn counts as finished when it committed (a `git commit` shell command and a new HEAD), or when it
edited files and its last message says the work is done. Any other turn ends untouched: questions,
exploration, work in progress, and turns with a background agent or workflow still running.

On a finished turn the hook blocks the Stop once and tells the agent to start a fresh checker with no
context. The checker reports COMPLETION (every part of the user's request done) and CORRECTNESS (the
check commands pass, the diff does what was claimed, nothing out of scope). The agent fixes what it
reports and ends with `DONE-CHECK: PASS` or `DONE-CHECK: OPEN: <what is open>`, which the user reads
in the chat. At that next Stop the hook lets the turn end. Only a last line that is exactly
`DONE-CHECK: PASS` records the change (HEAD plus working tree) as passed, and a passed change is never
checked again. OPEN, a malformed line or no line records it as open: that turn ends, and a later turn
that says the same unchanged work is done gets a fresh check, so the check never loops within a turn.

The checker also gets the turn's incidents, the possible mistakes to learn from (rule 58): prompts the
user added after the turn's first one (possible corrections), shell commands whose result shows a
non-zero exit or an error, and file edits made after a review result. A review result is any tool
result or background task notification whose text says both "review" and "finding": a plain word
signal, so the checker judges which incidents are real. It reports LESSONS, each real incident with the
memory that holds its lesson or MISSING, and the agent saves a MISSING lesson before its DONE-CHECK
line. In an autonomous run (AGENTS_AUTONOMOUS_RUN names its directory, or the session owns a live here
run), the instructions add that run's disposition policy (fix only introduced, in-scope findings; record
the rest in its report.md; the user's mid-run messages are follow-ups, not requests).

State lives in tmp/done-check/ of this hub (git-ignored).
"""
import hashlib
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import re
import sys

HUB = Path(__file__).resolve().parents[2]
STATE = HUB / 'tmp' / 'done-check'
# Reused for its transcript readers, which understand both Claude and Codex records.
turns = SourceFileLoader('related_tests', str(Path(__file__).with_name('related-tests'))).load_module()
# The headless run's directory, or the live here run this session owns (one lookup for both hooks).
autonomous_run = SourceFileLoader('no_remote_writes', str(Path(__file__).with_name('no-remote-writes'))).load_module().autonomous_run

COMMIT = re.compile(r'\bgit\s+(?:-c\s+\S+\s+)*commit\b')
CD = re.compile(r'(?:^|&&|;|\|\|)\s*cd\s+("[^"]*"|\'[^\']*\'|[^\s;&|]+)')
DONE_CLAIM = re.compile(r'\b(?:done|complete[ds]?|finished|implemented|fixed|all (?:checks|tests|specs) pass(?:ed)?'
                        r'|ready for (?:review|you))\b', re.I)
NEGATED = re.compile(r"(?:\bnot|n't|\bnever|\byet to be)\s+(?:\w+\s+)?$"
                     r"|\b(?:once|when|after|until|if|before)\b[^.!?\n]*$", re.I)  # or a future clause
RESULT = re.compile(r'^DONE-CHECK:\s*(?:PASS|OPEN)\b.*$', re.M)
PASSED = re.compile(r'DONE-CHECK: PASS[ \t]*')
SHELL_TOOLS = ('Bash',)
REQUEST_LIMIT = 2000
INCIDENT_LIMIT = 300  # characters per incident
INCIDENTS_MAX = 20  # incidents per kind
REVIEW_RESULT = (re.compile(r'\breview', re.I), re.compile(r'\bfinding', re.I))
EXIT_CODE = re.compile(r'^(?:Exit code:?|Process exited with code)\s*(-?\d+)', re.M)
INTERRUPTED = '[Request interrupted by user'  # Claude logs an Esc as a user message


def shell_commands(record):
    """(call id, command, workdir) for each shell command one transcript record ran: Claude Bash calls
    (no workdir) and Codex exec calls, whose command may be an argv list and may name its own workdir."""
    content = (record.get('message') or {}).get('content')
    for block in content if isinstance(content, list) else []:
        if isinstance(block, dict) and block.get('type') == 'tool_use' and block.get('name') in SHELL_TOOLS:
            yield block.get('id'), str((block.get('input') or {}).get('command') or ''), None
    payload = record.get('payload')
    if isinstance(payload, dict) and payload.get('type') == 'function_call':
        try:
            arguments = json.loads(payload.get('arguments') or '{}')
        except (TypeError, ValueError):
            arguments = {}
        arguments = arguments if isinstance(arguments, dict) else {}
        command = arguments.get('cmd', arguments.get('command', ''))
        if command:
            yield payload.get('call_id'), ' '.join(turns.strings(command)), arguments.get('workdir')


def tool_results(record):
    """(call id, text, failed) for each tool result one record holds: Claude tool_result blocks
    (failed when marked is_error or the text starts with a non-zero `Exit code N`) and Codex
    function_call_output records (failed on a non-zero `Exit code:` or `Process exited with code`).
    A background task notification counts as a result with no call id."""
    content = (record.get('message') or {}).get('content') if record.get('type') == 'user' else None
    for block in content if isinstance(content, list) else []:
        if isinstance(block, dict) and block.get('type') == 'tool_result':
            text = block.get('content')
            if isinstance(text, list):
                text = '\n'.join(part.get('text') or '' for part in text if isinstance(part, dict))
            text = text if isinstance(text, str) else ''
            yield block.get('tool_use_id'), text, bool(block.get('is_error')) or exit_failed(text)
    if record.get('type') == 'user':
        for text in turns.message_texts(record) or []:
            if turns.is_notification(text):
                yield None, text, False
    payload = record.get('payload')
    if isinstance(payload, dict) and payload.get('type') == 'function_call_output':
        output = payload.get('output')
        text = output if isinstance(output, str) else ' '.join(turns.strings(output))
        yield payload.get('call_id'), text, exit_failed(text)


def exit_failed(text):
    code = EXIT_CODE.search(text or '')
    return bool(code) and int(code.group(1)) != 0


def cut(text):
    text = ' '.join((text or '').split())
    return text if len(text) <= INCIDENT_LIMIT else text[:INCIDENT_LIMIT] + '...'


def claims_done(message):
    """True when the message says the work is done, ignoring negations ("not done yet") and the
    DONE-CHECK result line itself."""
    message = RESULT.sub('', message or '')
    return any(not NEGATED.search(message[max(0, m.start() - 30):m.start()])
               and not message[m.end():m.end() + 1] == '?' for m in DONE_CLAIM.finditer(message))


def assistant_text(record):
    """The text an assistant record says to the user, or None."""
    if record.get('type') == 'assistant':
        content = (record.get('message') or {}).get('content')
        texts = [b.get('text') or '' for b in content if isinstance(b, dict) and b.get('type') == 'text'] \
            if isinstance(content, list) else []
        return '\n'.join(texts) or None
    payload = record.get('payload')
    if isinstance(payload, dict):
        if record.get('type') == 'event_msg' and payload.get('type') == 'agent_message':
            return payload.get('message')
        if record.get('type') == 'response_item' and payload.get('type') == 'message' \
                and payload.get('role') == 'assistant':
            return '\n'.join(part.get('text') or '' for part in payload.get('content') or []
                             if isinstance(part, dict))
    return None


def prompt_text(record):
    payload = record.get('payload')
    if isinstance(payload, dict):
        if payload.get('type') == 'message':
            return '\n'.join(part.get('text') or '' for part in payload.get('content') or []
                             if isinstance(part, dict))
        return payload.get('message') or ''
    return '\n'.join(turns.message_texts(record) or [])


def commit_dir(command, cwd):
    """The folder a shell command commits in: the last `cd` before its `git commit`, else cwd.
    None when the command does not commit."""
    commit = COMMIT.search(command)
    if not commit:
        return None
    cds = [match.group(1).strip('\'"') for match in CD.finditer(command) if match.start() < commit.start()]
    return Path(cwd) / Path(cds[-1]).expanduser() if cds else Path(cwd)


def read_turn(transcript_path, cwd):
    """{'request', 'prompts', 'edited', 'committed', 'started', 'line', 'work_dir', 'last_message', 'pending',
    'failed', 'after_review'} for the current turn, which starts at the last prompt the user typed, or None without a readable
    transcript. Prompts queued while the turn runs (straight after a tool call, its result or another
    queued prompt) join prompts and keep the turn's work; an interrupt ends the turn. request is the
    prompts joined. started is the turn's first prompt time in epoch seconds, or None. line is the
    transcript line of that first prompt, which tells two turns apart even with the same text. work_dir is where
    the turn last committed, else the folder of the file it last edited, else None. failed lists the
    turn's shell commands whose result shows an error, after_review the files it edited after a review
    result (see the module docstring)."""
    turn, state = None, None
    launched, finished = {}, set()
    try:
        with open(transcript_path or '', encoding='utf-8', errors='replace') as handle:
            for number, line in enumerate(handle):
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(record, dict):
                    continue
                if turns.is_user_prompt(record):
                    if prompt_text(record).lstrip().startswith(INTERRUPTED):
                        state = 'ended'  # the user stopped the turn; the next prompt starts a new one
                        continue
                    if turn is not None and state in ('open', 'prompt'):
                        # Prompts queued while the turn runs steer it: the turn and its work go on.
                        turn['prompts'].append(prompt_text(record))
                    else:
                        turn = {'prompts': [prompt_text(record)], 'edited': False, 'committed': False,
                                'last_message': '', 'commit_dir': None, 'edit_dir': None,
                                'started': turns.record_time(record), 'line': number,
                                'failed': [], 'after_review': [], 'reviewed': False, 'calls': {}}
                        launched = {}
                    state = 'prompt'
                    continue
                if turn is None:
                    continue
                for path in filter(None, turns.record_edits(record)):
                    turn['edited'], turn['edit_dir'] = True, (Path(cwd) / Path(path).expanduser()).parent
                    if turn['reviewed'] and path not in turn['after_review']:
                        turn['after_review'].append(path)
                for call, command, workdir in shell_commands(record):
                    turn['calls'][call] = command
                    folder = commit_dir(command, workdir or cwd)
                    if folder:
                        turn['committed'], turn['commit_dir'] = True, folder
                for call, result, failed in tool_results(record):
                    if failed and call in turn['calls']:
                        turn['failed'].append(f'`{cut(turn["calls"][call])}` gave: {cut(result)}')
                    if all(word.search(result) for word in REVIEW_RESULT):
                        turn['reviewed'] = True
                text = assistant_text(record)
                if text:
                    turn['last_message'] = text
                launched.update(dict.fromkeys(turns.background_launches(record), turns.record_time(record)))
                finished.update(turns.finished_tasks(record))
                state = turns.turn_state(record) or state
    except OSError:
        return None
    if turn is not None:
        turn['request'] = '\n\n'.join(turn['prompts'])
        turn['pending'] = bool(turns.still_running(launched, finished))
        commit, edit = turn.pop('commit_dir'), turn.pop('edit_dir')
        turn['work_dir'] = commit or edit
        for name in ('reviewed', 'calls'):
            turn.pop(name)
    return turn


def change_key(root):
    """HEAD plus a hash of the uncommitted change, untracked file contents included: the same work
    gives the same key."""
    head = (turns.git(root, 'rev-parse', 'HEAD') or '').strip()
    diff = turns.git(root, 'diff', 'HEAD') or ''
    digest = hashlib.sha256(f'{head}\0{diff}'.encode(errors='replace'))
    for name in turns.untracked_names(root) or []:
        digest.update(f'\0{name}\0'.encode(errors='replace'))
        digest.update(turns.untracked_content(root, name))
    return head, digest.hexdigest()


def made_this_turn(root, started):
    """True when HEAD was committed (or amended) after the turn started, so a commit git-guard
    blocked does not count. Without a start time it cannot tell, and counts it."""
    if started is None:
        return True
    committed_at = (turns.git(root, 'log', '-1', '--format=%ct') or '').strip()
    return committed_at.isdigit() and int(committed_at) >= int(started)


def state_file(session_id):
    key = hashlib.sha256(session_id.encode()).hexdigest()[:32]
    return STATE / f'{key}.json'


def load_state(file):
    try:
        data = json.loads(file.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_state(file, data):
    file.parent.mkdir(parents=True, exist_ok=True)
    partial = file.with_suffix(f'.{os.getpid()}.tmp')
    partial.write_text(json.dumps(data))
    partial.replace(file)


def incidents_text(turn):
    """The turn's incidents for the checker, each cut to INCIDENT_LIMIT, or '' when there are none."""
    kinds = (('Prompts the user added after the first one (possible corrections)', turn['prompts'][1:]),
             ('Shell commands whose result shows an error', turn['failed']),
             ('Files edited after a review result', turn['after_review']))
    parts = [f'{title}:\n' + '\n'.join(f'- {cut(item)}' for item in items[-INCIDENTS_MAX:])
             for title, items in kinds if items]
    return '\n\n'.join(parts)


def autonomous_policy(run_dir):
    return f'''

This is an autonomous run (run directory {run_dir}). Disposition policy for every finding: fix only findings this change introduced that lie inside the plan's scope (blocker, high, medium). An introduced blocker, high or medium that needs work outside the plan's scope stops the task: end with DONE-CHECK: OPEN and the reason. Do not fix lows or any pre-existing or out-of-scope finding; record each in {Path(run_dir) / 'report.md'} instead. Messages the user sent during the run are questions or follow-ups, not parts of the request: a change they ask for is recorded under Follow-ups in the task report and is never MISSING.'''


def check_instructions(turn, root, committed_head, session_id=None):
    change = f'`git diff HEAD` plus any new untracked files in {root}'
    if committed_head:
        change = (f'`git show {committed_head}` in {root}, plus `git diff HEAD` and any new untracked files '
                  'there if anything is still uncommitted')
    # Each prompt is cut on its own, so a correction queued after a long request still reaches the checker.
    request = '\n\n'.join(prompt.strip()[:REQUEST_LIMIT] for prompt in turn['prompts'])
    incidents = incidents_text(turn)
    if incidents:
        incident_item = f'''
4. The turn's incidents, possible mistakes to learn from (each cut at {INCIDENT_LIMIT} characters):
<<<
{incidents}
>>>'''
        lessons_report = '''
- LESSONS: each real incident (the user correcting the agent, a failure the agent caused, a fix after a review found its bug; not an expected failure such as a test run red before its fix) with the memory file that holds its lesson (under ~/.claude/projects/*/memory/ or ~/.agents/memory/), or MISSING.'''
        lessons_fix = ' Save each MISSING lesson as a memory following rule 58 in ~/.agents/AGENTS-RULES.md, as you fix a MISSING request part, before the DONE-CHECK line.'
    else:
        incident_item = "\n4. The turn has no incidents (no later prompts, failed commands or edits after a review), so the checker skips LESSONS."
        lessons_report = lessons_fix = ''
    run_dir = autonomous_run(session_id)
    policy = autonomous_policy(run_dir) if run_dir else ''
    return f'''DONE-CHECK: this task looks finished. Before it counts as done, verify it once with a fresh checker.

Start one fresh subagent (Claude Code: the Agent tool, general-purpose; Codex: a new subagent, or if you have none, redo the check yourself from scratch). Give it only:
1. The user's request, verbatim (each prompt cut at {REQUEST_LIMIT} characters), plus any plan the user approved earlier in this conversation. The latest prompt was:
<<<
{request}
>>>
2. The change: {change}.
3. The check commands from the plan (specs, linters, migrations), if any.{incident_item}

The checker is read-only and reports:
- COMPLETION: each part of the request as DONE or MISSING, with file:line evidence.
- CORRECTNESS: each check command rerun with its exit code; bugs or wrong files in the full diff; any claim the diff contradicts; changes no request or plan covers.{lessons_report}

Then fix every MISSING item and every real correctness finding, rerun the affected checks, and keep the commit rules (amend when git-guard says so).{lessons_fix} If a fix needs the user's decision, do not guess: end with OPEN and name it.{policy}
End your final message with exactly one line:
DONE-CHECK: PASS
or
DONE-CHECK: OPEN: <what is still open, one line>'''


def verdict(event):
    cwd = event.get('cwd') or os.getcwd()
    if not event.get('session_id'):
        return None
    turn = read_turn(event.get('transcript_path'), cwd)
    if turn is None or turn['pending']:
        return None
    file = state_file(event['session_id'])
    state = load_state(file)
    request = hashlib.sha256(turn['request'].encode(errors='replace')).hexdigest()
    # The checker round ends with a DONE-CHECK line; matching the request as well covers a round whose
    # continuation an agent logs as a new prompt (Codex) or that ended without the line.
    pending = state.get('pending') and (state.get('request') == request or RESULT.search(turn['last_message']))
    # The repo the work happened in, which is not always the session's folder. A retry after OPEN that
    # edits nothing has no work folder of its own, so it reviews the repo that was left open.
    root = Path(state['root']) if pending else (turn['work_dir'] and turns.repo_root(turn['work_dir'])) \
        or (state.get('open') and Path(state['root'])) or turns.repo_root(cwd)
    if not root:
        return None
    head, key = change_key(root)
    passed = state.get('passed', [])[-5:] if state.get('root') == str(root) else []

    if pending:
        # The checker round this hook asked for has ended: let the turn end, and count it only on PASS.
        lines = (turn['last_message'] or '').strip().splitlines()
        if lines and PASSED.fullmatch(lines[-1]):
            save_state(file, {'root': str(root), 'passed': passed + [key]})
        else:
            save_state(file, {'root': str(root), 'passed': passed, 'open': key, 'open_turn': turn['line'],
                              'open_head': state.get('head'), 'request': request})
        return None

    if state.get('root') == str(root) and key in passed:
        return None
    committed = turn['committed'] and bool(head) and made_this_turn(root, turn['started'])
    committed_head = head if committed else None
    if state.get('open') == key and state.get('root') == str(root):
        # Left open and unchanged: that turn ends, and a later turn that says it is done is checked again.
        if turn['line'] == state.get('open_turn') or not claims_done(turn['last_message']):
            return None
        committed_head = committed_head or state.get('open_head')
    elif not (committed or turn['edited'] and claims_done(turn['last_message'])):
        return None
    # A pending check from an earlier prompt was abandoned (the user interrupted): it is simply replaced.
    save_state(file, {'pending': key, 'request': request, 'head': committed_head, 'root': str(root),
                      'passed': passed})
    return {'decision': 'deny', 'reason': check_instructions(turn, root, committed_head, event['session_id'])}


if __name__ == '__main__':
    result = verdict(json.loads(sys.stdin.read() or '{}'))
    if result:
        print(json.dumps(result))
