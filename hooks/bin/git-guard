#!/usr/bin/env python3
"""Enforce the git rules agents tend to skip (AGENTS-RULES.md 43, 48 and 54) before a shell command runs.

Rule 54 is one unpushed commit per branch, or one per `[feature]` subject tag when the repo's
`.git-guard.json` says {"commits": "per-feature"}.

Reads the normalized hook event (see ../adapters/run.py). For a rule break it returns
{"decision": "deny", "reason": ...} that says what to run instead (the `cd` form of a
`git -C` command, the amend command, a one-line message, or to leave the change uncommitted
and report), so the agent corrects itself. It never asks the user: agents run unattended.
"""
import json
import os
import re
import shlex
import subprocess
import sys

FEATURE_TAG = re.compile(r'^\[([^\]]+)\]\s*\S')
ATTRIBUTION = re.compile(r'Co-Authored-By:\s*Claude|Claude-Session|Generated with \[?Claude Code', re.I)
SEPARATOR = re.compile(r'^[;&|]+$')
WRAPPERS = {'command', 'env', 'exec', 'nohup', 'time', 'sudo'}
HEREDOC = re.compile(r'''<<(-?)[ \t]*((?:[^\s;&|<>\\'"]|\\.|'[^']*'|"[^"]*")+)''')
# git options that come before the subcommand and take the next word as their value.
GLOBAL_OPTIONS_WITH_VALUE = {'-c', '-C', '--git-dir', '--work-tree', '--namespace', '--super-prefix', '--config-env'}


# Options whose separate argument belongs to a wrapper, not its command.
WRAPPER_OPTIONS_WITH_VALUE = {
    'env': {'-u', '--unset', '-C', '--chdir', '-S', '--split-string'},
    'sudo': {'-u', '--user', '-g', '--group', '-h', '--host', '-p', '--prompt',
             '-C', '--close-from', '-T', '--command-timeout', '-r', '--role', '-t', '--type'},
    'exec': {'-a'},
    'time': {'-f', '--format', '-o', '--output'},
}


def parse_shell(command):
    """One lexical traversal for substitutions, quotes, comments and heredocs.

    Each region retains normalized source for message checks and masked words for
    command checks. Substitutions own their lexical context and directory scope.
    No shell code is evaluated.
    """
    prefix = '__git_guard_substitution_'
    while prefix in command:
        prefix += '_'
    i = 0

    def scan(closing=None, heredoc=None):
        nonlocal i
        original, masked, substitutions = [], [], {}
        quote, word_start, depth = None, True, 0
        pending_heredocs = []

        def append(text):
            original.append(text)
            if heredoc is None:
                masked.append(text)

        def result():
            return (''.join(original), ''.join(masked), substitutions)

        while i < len(command):
            char = command[i]
            if heredoc and (i == 0 or command[i - 1] == '\n'):
                end = command.find('\n', i)
                end = len(command) if end == -1 else end + 1
                line = command[i:end]
                candidate = line.rstrip('\n')
                if heredoc[2]:
                    candidate = candidate.lstrip('\t')
                if candidate == heredoc[0]:
                    i = end
                    return result(), line
            if heredoc and heredoc[1]:
                append(char)
                i += 1
                continue
            if char == '\\' and quote != "'":
                pair = command[i:i + 2]
                if pair != '\\\n':
                    append(pair)
                    word_start = False
                i += len(pair)
                continue
            if (closing == '`' and char == '`') or (
                    closing == ')' and char == ')' and quote is None and depth == 0 and heredoc is None):
                i += 1
                return result(), char
            if heredoc is None and quote is None and word_start and char == '#':
                end = command.find('\n', i)
                end = len(command) if end == -1 else end
                original.append(command[i:end])
                i = end
                continue
            if heredoc is None and quote is None and char == '\n' and pending_heredocs:
                original.append(char)
                i += 1
                for delimiter in pending_heredocs:
                    body, terminator = scan(heredoc=delimiter)
                    original.extend((body[0], terminator))
                    # Heredoc literals are data; only their substitutions execute.
                    for marker, substitution in body[2].items():
                        renamed = f'{prefix}{len(substitutions)}__'
                        substitutions[renamed] = substitution
                        masked.append(' ' + renamed)
                pending_heredocs.clear()
                masked.append('\n')
                word_start = True
                continue
            if (heredoc is None and quote is None and command.startswith('<<', i)
                    and not command.startswith('<<<', i) and (i == 0 or command[i - 1] != '<')):
                match = HEREDOC.match(command, i)
                if match:
                    raw = match[2]
                    pending_heredocs.append((shlex.split(raw)[0], any(c in raw for c in "\"'\\"), bool(match[1])))
                    append(match[0])
                    i = match.end()
                    word_start = False
                    continue
            if quote != "'" and (command.startswith('$(', i) or char == '`'):
                opener = '`' if char == '`' else '$('
                i += len(opener)
                body, terminator = scan(closing='`' if opener == '`' else ')')
                spelling = opener + body[0] + terminator
                marker = f'{prefix}{len(substitutions)}__'
                substitutions[marker] = (body, spelling)
                original.append(spelling)
                masked.append(marker)
                word_start = False
                continue
            if heredoc is None:
                if quote:
                    if char == quote:
                        quote = None
                elif char in "\"'":
                    quote = char
                elif char == '(':
                    depth += 1
                elif char == ')' and depth:
                    depth -= 1
                word_start = quote is None and (char.isspace() or char in ';&|()<>')
            append(char)
            i += 1
        if closing or heredoc or pending_heredocs or quote:
            raise ValueError('unclosed shell quote, substitution or heredoc')
        return result(), ''

    return scan()[0]


def unquoted_newlines_to_separators(command):
    """Newlines outside quotes end a command, as in a shell script; newlines inside quotes
    (a heredoc message in "$(cat <<EOF ...)") stay part of their word."""
    out, quote, escaped = [], None, False
    for char in command:
        if escaped:
            escaped = False
        elif char == '\\' and quote != "'":
            escaped = True
        elif quote:
            quote = None if char == quote else quote
        elif char in '"\'':
            quote = char
        elif char == '\n':
            char = ';'
        out.append(char)
    return ''.join(out)


def segments(command):
    """Shell command split into simple commands (word lists)."""
    lexer = shlex.shlex(unquoted_newlines_to_separators(command), posix=True, punctuation_chars=';&|')
    lexer.whitespace_split = True
    lexer.commenters = ''  # `issue#3` is a word, not a comment
    current = []
    for token in lexer:
        token = token.strip('(){}') if token not in ('(', ')', '{', '}') else ''  # subshells and groups
        if not token:
            continue
        if SEPARATOR.match(token):
            if current:
                yield current
            current = []
        else:
            current.append(token)
    if current:
        yield current


def git_invocation(words):
    """(global options, subcommand, its arguments) when the words run git, else None."""
    while words:
        if re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', words[0]):
            words = words[1:]
            continue
        wrapper = os.path.basename(words[0])
        if wrapper not in WRAPPERS:
            break
        words = words[1:]
        while words and words[0].startswith('-'):
            option = words[0]
            words = words[1:]
            if option == '--':
                break
            if option in WRAPPER_OPTIONS_WITH_VALUE.get(wrapper, set()) and words:
                words = words[1:]
    if not words or os.path.basename(words[0]) != 'git':
        return None
    options, i = [], 1
    while i < len(words) and words[i].startswith('-'):
        options.append(words[i])
        if words[i] in GLOBAL_OPTIONS_WITH_VALUE and i + 1 < len(words):
            options.append(words[i + 1])
            i += 1
        i += 1
    return options, (words[i] if i < len(words) else None), words[i + 1:]


def git(directory, *args):
    result = subprocess.run(['git', *args], cwd=directory, capture_output=True, text=True, timeout=10)
    return result.stdout.strip() if result.returncode == 0 else None


# Short commit options that take no value, so they can lead a cluster such as `-qm` or `-aF`.
FLAG_CLUSTER = '-[aqnsveoip]*'
OTHER_SOURCES = ('--file', '--reuse-message', '--reedit-message', '--template', '--squash')


def message_sources(args):
    """Every place `git commit` would take its message from, in order: ('m', text), ('fixup', target)
    or ('other', option) for a file, an earlier commit, a template or --squash."""
    sources, i = [], 0
    while i < len(args):
        arg = args[i]
        value = args[i + 1] if i + 1 < len(args) else None
        if arg in ('--message', '--fixup') or re.fullmatch(FLAG_CLUSTER + 'm', arg):
            if value is not None:
                sources.append(('fixup' if arg == '--fixup' else 'm', value))
            i += 1
        elif arg in OTHER_SOURCES or re.fullmatch(FLAG_CLUSTER + '[CcFt]', arg):
            sources.append(('other', arg))
            i += 1
        elif arg.startswith(('--message=', '--fixup=')):
            sources.append(('fixup' if arg.startswith('--fixup=') else 'm', arg.split('=', 1)[1]))
        elif glued := re.fullmatch(FLAG_CLUSTER + 'm(.+)', arg, re.S):
            sources.append(('m', glued[1]))
        elif (arg.startswith(tuple(f'{option}=' for option in OTHER_SOURCES))
              or re.fullmatch(FLAG_CLUSTER + '[CcFt].+', arg)):
            sources.append(('other', arg.split('=', 1)[0]))
        i += 1
    return sources


# Every long option of `git commit` (`git commit --git-completion-helper-all`), for reading abbreviations as git does.
COMMIT_LONG_OPTIONS = (
    'quiet verbose file author date message reedit-message reuse-message fixup squash reset-author trailer signoff '
    'template edit cleanup status gpg-sign all include interactive patch only no-verify dry-run short branch '
    'ahead-behind porcelain long null amend no-post-rewrite untracked-files pathspec-from-file pathspec-file-nul '
    'allow-empty allow-empty-message verify post-rewrite no-quiet no-verbose no-file no-author no-date no-message '
    'no-reedit-message no-reuse-message no-fixup no-squash no-reset-author no-signoff no-template no-edit no-cleanup '
    'no-status no-gpg-sign no-all no-include no-interactive no-patch no-only no-dry-run no-short no-branch '
    'no-ahead-behind no-porcelain no-long no-null no-amend no-untracked-files no-pathspec-from-file '
    'no-pathspec-file-nul no-allow-empty no-allow-empty-message').split()
VALUE_OPTIONS = ('--message', '--file', '--reuse-message', '--reedit-message', '--template', '--fixup', '--squash',
                 '--author', '--date', '--trailer', '--cleanup', '--pathspec-from-file')


def expand_long_options(args):
    """The arguments with each unique abbreviation of a long option (`--amen`, `--reuse=HEAD`) spelled out, as git
    reads it. Option values and everything after `--` stay as given."""
    expanded, takes_value = [], False
    for i, arg in enumerate(args):
        if arg == '--':
            return expanded + list(args[i:])
        if not takes_value and arg.startswith('--'):
            name, sep, value = arg.partition('=')
            options = [option for option in COMMIT_LONG_OPTIONS if f'--{option}' == name] or [
                option for option in COMMIT_LONG_OPTIONS if f'--{option}'.startswith(name)]
            if len(options) == 1:
                arg = f'--{options[0]}{sep}{value}'
            takes_value = arg in VALUE_OPTIONS
        else:
            takes_value = not takes_value and bool(re.fullmatch(FLAG_CLUSTER + '[mCcFt]', arg))
        expanded.append(arg)
    return expanded


def commit_messages(args):
    return [text for kind, text in message_sources(args) if kind == 'm']


MODES = ('single', 'per-feature')


def commit_mode(directory):
    """(mode, problem): the repo's `.git-guard.json` "commits" mode ("single" without the file), or
    (None, what is wrong with that file)."""
    top = git(directory, 'rev-parse', '--show-toplevel')
    if top is None:
        return 'single', None
    try:
        with open(os.path.join(top, '.git-guard.json'), encoding='utf-8') as config:
            settings = json.load(config)
    except FileNotFoundError:
        return 'single', None
    except (OSError, ValueError) as error:
        return None, f'it cannot be read as JSON: {error}'
    if not isinstance(settings, dict):
        return None, 'it is not a JSON object'
    mode = settings.get('commits', 'single')
    return (mode, None) if mode in MODES else (None, f'it has "commits": {json.dumps(mode)}')


def feature_tag(subject):
    match = FEATURE_TAG.match(subject or '')
    return match[1].strip().lower() if match else None


class Correction(str):
    """A problem the agent fixes itself by rerunning differently; no user approval needed."""


def check_commit(directory, args):
    problems = []
    messages = commit_messages(args)
    if len(messages) > 1 or any('\n' in m.strip() for m in messages):
        problems.append(Correction('rule 48: the commit message must be a single line. Rerun it with one `-m "<one line>"`'))
    if any(ATTRIBUTION.search(m) for m in messages):
        problems.append(Correction('rule 48: no Claude attribution in commits. Rerun it without the attribution line'))
    if not os.path.isdir(directory):
        return problems  # a path only the shell knows ($D from mktemp): not the user's branch
    has_head = git(directory, 'rev-parse', '--verify', '-q', 'HEAD') is not None
    unpushed = int(git(directory, 'rev-list', '--count', 'HEAD', '--not', '--remotes') or 0) if has_head else 0
    amend = '--amend' in args
    mode, bad_setting = commit_mode(directory)
    if bad_setting:
        return problems + [Correction(f'rule 54: .git-guard.json must be {{"commits": "single"}} or '
                                      f'{{"commits": "per-feature"}}, but {bad_setting}. Leave the change uncommitted '
                                      'and report the bad setting')]
    if mode == 'per-feature':
        return problems + check_feature_commit(directory, args, has_head)
    if unpushed > 1:
        problems.append(Correction(f'rule 54: this branch already has {unpushed} unpushed commits. Do not commit or '
                                   'squash; leave the change uncommitted and tell the user the branch needs squashing first'))
    elif unpushed == 1 and not amend:
        subject = git(directory, 'log', '-1', '--format=%s') or ''
        problems.append(Correction(
            f'rule 54: one unpushed commit already exists ("{subject}"), so do not add a second one. '
            'If this change belongs with it, rerun this as '
            '`git commit --amend --no-edit` to fold the change into it, or `git commit --amend -m "<one line>"` '
            'to also update its message. If it is unrelated work, do not amend; report that the branch already holds it'))
    elif unpushed == 0 and amend and has_head:
        problems.append(Correction('rule 54: --amend here would rewrite a commit that is already pushed. '
                                   'Rerun it as a new commit, without --amend'))
    return problems


def rebase_base(directory, sha, shas):
    """The base for `git rebase --autosquash` onto `sha`, or None when that rebase would replay a merge or a
    pushed commit (after a `git pull`, say) and so rewrite history."""
    has_parent = git(directory, 'rev-parse', '--verify', '-q', f'{sha}~1') is not None
    span = f'{sha}~1..HEAD' if has_parent else 'HEAD'
    replayed = set((git(directory, 'rev-list', span) or '').split())
    if git(directory, 'rev-list', '--min-parents=2', span) or replayed - set(shas):
        return None
    return f'{sha[:12]}~1' if has_parent else '--root'


def check_feature_commit(directory, args, has_head):
    """Rule 54 per-feature mode: one unpushed commit per `[feature]` subject tag."""
    args = expand_long_options(args)
    messages, amend = commit_messages(args), '--amend' in args
    log = git(directory, 'log', '--format=%H%x00%s', 'HEAD', '--not', '--remotes') if has_head else ''
    unpushed = [(line.split('\0', 1) + [''])[:2] for line in (log or '').splitlines()]
    shas = [sha for sha, _ in unpushed]
    sources = message_sources(args)
    others = [option for kind, option in sources if kind == 'other']
    fixups = [target for kind, target in sources if kind == 'fixup']
    if others:
        rerun = ('`git commit --amend --no-edit`, or `git commit --amend -m "[<its feature>] <one line>"`' if amend
                 else '`git commit -m "[<feature>] <one line>"`')
        return [Correction(f'rule 54: {others[0]} takes the message from somewhere the feature tag cannot be '
                           f'checked. Rerun it as {rerun}')]
    if len(fixups) > 1 or (fixups and amend):
        return [Correction('rule 54: give one plain `git commit --fixup=<sha>`, without --amend or a second --fixup')]
    target = fixups[0] if fixups else None
    if target is not None and re.match(r'(amend|reword):', target):
        return [Correction(f'rule 54: --fixup={target} rewrites the feature commit\'s message and could change its '
                           'tag. Rerun it as a plain `git commit --fixup=<sha>`')]
    if target is not None:
        named = git(directory, 'rev-parse', '--verify', '-q', '--end-of-options', target)
        sha = named and git(directory, 'rev-parse', '--verify', '-q', f'{named}^{{commit}}')
        if sha not in shas:
            return [Correction(f'rule 54: --fixup={target} is not an unpushed commit on this branch, so it must not be '
                               'rewritten. Commit it as new work with its own `[feature]` tag instead')]
        if rebase_base(directory, sha, shas) is None:
            return [Correction(f'rule 54: a merge or pushed commit sits in the history the --fixup={target} rebase '
                               'would replay, so it would rewrite history. Leave the change uncommitted and tell the user')]
        return []
    if amend:
        if has_head and (not shas or shas[0] != git(directory, 'rev-parse', 'HEAD')):
            return [Correction('rule 54: --amend here would rewrite a commit that is already pushed. '
                               'Rerun it as a new commit with a `[feature]` tag, without --amend')]
        if not messages and '--no-edit' not in args:
            return [Correction('rule 54: an amend here must say its message, so its feature tag can be checked. Rerun it '
                               'as `git commit --amend --no-edit`, or `--amend -m "[<its feature>] <one line>"`')]
        head_tag = feature_tag(unpushed[0][1]) if unpushed else None
        if messages and head_tag and feature_tag(messages[0]) != head_tag:
            return [Correction(f'rule 54: an amend keeps its feature, so the new subject must still start with '
                               f'"[{head_tag}]". Rerun it with that tag')]
        new_tag = feature_tag(messages[0]) if messages else None
        for _, subject in unpushed[1:]:
            if new_tag and feature_tag(subject) == new_tag:
                return [Correction(f'rule 54: feature "[{new_tag}]" already has its unpushed commit ("{subject}"), so '
                                   'this amend would make a second one. Keep HEAD\'s own subject, or use another tag')]
        return []
    if not messages:
        return [Correction('rule 54: this repo commits one change per feature, so give the subject with '
                           '`-m "[<feature>] <one line>"`')]
    tag = feature_tag(messages[0])
    if not tag:
        return [Correction('rule 54: this repo commits one change per feature, so the subject must start with its '
                           'feature tag followed by a description. Rerun it as '
                           '`git commit -m "[<feature>] <one line>"`, reusing the tag of an unpushed commit when this '
                           'change belongs to that feature')]
    for index, (sha, subject) in enumerate(unpushed):
        if feature_tag(subject) != tag:
            continue
        if index == 0:
            return [Correction(f'rule 54: feature "[{tag}]" already has its unpushed commit ("{subject}"), which is '
                               'HEAD. Fold this change into it with `git commit --amend --no-edit`')]
        base = rebase_base(directory, sha, shas)
        if base is None:
            return [Correction(f'rule 54: feature "[{tag}]" already has its unpushed commit ("{subject}", {sha[:12]}), '
                               'but a merge or pushed commit sits in the history a rebase onto it would replay. '
                               'Leave the change uncommitted and tell the user')]
        return [Correction(f'rule 54: feature "[{tag}]" already has its unpushed commit ("{subject}", {sha[:12]}). '
                           f'Fold this change into it with `git commit --fixup={sha[:12]}`, then '
                           f'`git rebase --autosquash --autostash {base}`')]
    return []


def shell_path(path):
    """A path as the agent should type it: `~` and `$NAME` stay live, anything unsafe is quoted."""
    return path if re.fullmatch(r'[\w~$.{}/+:@%-]+', path) else shlex.quote(path)


def rule_43_correction(options, subcommand, args):
    """The git command rewritten to cd into each -C directory first, for the agent to rerun."""
    dirs, rest, i = [], [], 0
    while i < len(options):
        if options[i] == '-C':
            dirs.append(options[i + 1] if i + 1 < len(options) else '<dir>')
            i += 2
        else:
            rest.append(options[i])
            i += 1
    rest += ([subcommand] if subcommand else []) + list(args)
    cds = ' && '.join(f'cd {shell_path(d)}' for d in dirs)
    rewritten = f'{cds} && git {shlex.join(rest)}'.rstrip()
    return Correction('rule 43: run git from inside the repo, not with `git -C`. Rerun it as '
                      f'`{rewritten}`, keeping anything that came before `git` (env assignments, wrappers)')


def problems_in(parsed, cwd):
    problems, directory = [], cwd
    _, masked, substitutions = parsed
    for words in segments(masked):
        for marker, (body, original) in substitutions.items():
            if any(marker in word for word in words):
                problems += problems_in(body, directory)
                words = [word.replace(marker, original) for word in words]
        if words[0] == 'cd' and len(words) > 1:
            directory = os.path.join(directory, os.path.expanduser(words[1]))
            continue
        invocation = git_invocation(words)
        if not invocation:
            continue
        options, subcommand, args = invocation
        if '-C' in options:  # only git's own -C; `git log -C` is a different option
            problems.append(rule_43_correction(options, subcommand, args))
            continue  # the rerun in the right directory gets the commit checks
        if subcommand == 'commit':
            problems += check_commit(directory, args)
    return problems


def verdict(event):
    command = (event.get('input') or {}).get('command') or ''
    try:
        problems = problems_in(parse_shell(command), event.get('cwd') or os.getcwd())
    except Exception as error:
        # Unparseable shell syntax: ask only when a commit or
        # git -C could be hiding in it; never wave such a command through unchecked.
        command = command.replace('\\\n', '')
        if not re.search(r'\bgit\b[^\n]*(?:\bcommit\b|(?<!\S)-C(?:\s|$))', command):
            return None
        if not re.search(r'\bgit\b[^\n]*\bcommit\b', command):
            return {'decision': 'deny', 'reason': 'Git rules (AGENTS-RULES.md): rule 43: this command could not be '
                    f'parsed ({error}) and may use `git -C`. Rewrite it as plain `cd <dir> && git ...` commands.'}
        return {'decision': 'deny', 'reason': 'Git rules (AGENTS-RULES.md): this command could not be checked against '
                f'rules 43, 48 and 54 ({error}). Split it into simple commands, each `cd <dir> && git ...`, and rerun them.'}
    if not problems:
        return None
    # Every problem says what to do instead, so the agent corrects itself; nothing waits for the user.
    return {'decision': 'deny', 'reason': 'Git rules (AGENTS-RULES.md): ' + '; '.join(problems) + '.'}

if __name__ == '__main__':
    result = verdict(json.loads(sys.stdin.read() or '{}'))
    if result:
        print(json.dumps(result))
