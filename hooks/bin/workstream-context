#!/usr/bin/env python3
"""SessionStart: tell the agent which workstreams are linked to this repo.

Reads the normalized hook event (see ../adapters/run.py). Prints {"context": ...} with one line
per linked workstream, or nothing when there are none. Any error prints nothing: a start hook
must never get in the way of a session.
"""
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'hub'))

from agents_hub import workstreams  # noqa: E402
from agents_hub.paths import Paths  # noqa: E402

GUIDE = ('Before working on one, run `agents-hub workstream show <id>`. Record what you learn with '
         '`agents-hub workstream update <id> --revision <N> --note ... --source ...` (add --verified only '
         'when you checked it live), or `agents-hub workstream skip <id> --reason ...` when nothing changed. '
         'Never edit the workstream files directly.')


def main():
    event = json.loads(sys.stdin.read() or '{}')
    found = workstreams.matching(Paths.from_env(), event.get('cwd') or '.')
    if found:
        lines = '\n'.join(workstreams.summary_line(r) for r in found)
        print(json.dumps({'context': f'Workstreams linked to this repo:\n{lines}\n{GUIDE}'}))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:  # never block a session start
        print(f'workstream-context: {error}', file=sys.stderr)
